{
  "height": 30, // Waybar height (to be removed for auto height)
  "layer": "top", // Waybar at top layer
  "margin-top": 16,
  "margin-left": 20,
  "margin-bottom": 0,
  "margin-right": 5,
  "spacing": 10, // Gaps between modules (4px)
  "modules-left": [
    "custom/launcher",
    "cpu",
    "memory",
    "custom/weather"
  ],
  "modules-center": [
    "custom/spotify",
    "hyprland/window",
    "hyprland/workspaces"
  ],
  "modules-right": [
    "tray",
    "pulseaudio",
    "network",
    "clock",
    "custom/power-menu"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "urgent": "",
      "active": "",
      "default": ""
    },
    "persistent-worspaces": {
      "*": [
        2,
        3,
        4,
        5,
        6
      ]
    }
  },
  "hyprland/window": {
    "format": "( {class} )",
    "rewrite": {
      "(.*) - Mozilla Firefox": " $1",
      "(.*) - zsh": "> [$1]"
    }
  },
  "tray": {
    "spacing": 20
  },
  "clock": {
    "format": "<span color='#bf616a'>\uf073  </span>{:%a %b %d %I:%M %p}",
    "format-alt": "<span color='#bf616a'>   </span>{:%I:%M %p}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "interval": 10,
    "format": "\uf4bc  {}%",
    "max-length": 10,
    "on-click": "kitty btop"
  },
  "memory": {
    "interval": 30,
    "format": "\uf1c0  {}%",
    "format-alt": "  {used:0.1f}G",
    "max-length": 10
  },
  "network": {
    "format-wifi": "\uf1eb   {signalStrength}%",
    "format-ethernet": "\uf0201 wired",
    "on-click": "bash ~/.config/waybar/scripts/rofi-wifi-menu.sh",
    "format-disconnected": "\uf0202Disconnected  ",
    "tooltip-format": "{ipaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)  | {ipaddr}",
    "tooltip-format-ethernet": "{ifname} 🖧 | {ipaddr}",
    "on-click": "notify-send 'Nmtui'; kitty nmtui"
  },
  "pulseaudio": {
    "format": "{icon}   {volume}%",
    "format-muted": "\uf466",
    "format-icons": {
      "headphone": "",
      "hands-free": "\uf0d26",
      "headset": "\uee59",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "custom/weather": {
    "format": "{}",
    "return-type": "json",
    "interval": "once",
    "exec": "bash ~/.config/waybar/scripts/weather.sh",
    "on-click": "firefox https://wttr.in/Athens"
  },
  "custom/spotify": {
    "exec": "python3 ~/.config/waybar/scripts/mediaplayer.py --player spotify",
    "format": "{}  ",
    "return-type": "json",
    "on-click": "playerctl play-pause",
    "on-double-click-right": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "custom/power-menu": {
    "format": "<span color='#6a92d7'>\u23fb </span>",
    "on-click": "wlogout"
  },
  "custom/launcher": {
    "format": "<span color='#6a92d7'>\uf14de</span>",
    "on-click": "wofi --show drun"
  }
}
